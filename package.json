{
  "name": "whisper-desktop",
  "version": "1.0.0",
  "description": "Cross-platform speech-to-text application using Electron, React, and Whisper.cpp",
  "main": "dist/main.js",
  "scripts": {
    "setup": "node scripts/setup-resources.js",
    "diagnose": "node scripts/diagnose.js",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:electron": "node scripts/build-electron.js",
    "build:react": "vite build",
    "build": "npm run build:electron && npm run build:react && electron-builder",
    "build:win": "npm run build:electron && npm run build:react && electron-builder --win",
    "build:mac": "npm run build:electron && npm run build:react && electron-builder --mac",
    "build:linux": "npm run build:electron && npm run build:react && electron-builder --linux",
    "compile": "npm run build:electron && npm run build:react"
  },
  "keywords": [
    "electron",
    "react",
    "whisper",
    "speech-to-text",
    "audio",
    "transcription"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.28.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.whisper.desktop",
    "productName": "Whisper Desktop",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
